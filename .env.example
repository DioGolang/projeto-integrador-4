# Configuração de Banco de Dados
POSTGRES_USER=root
POSTGRES_PASSWORD=password
POSTGRES_DB=logistics
POSTGRES_PORT=5432
POSTGRES_HOST=localhost

# Configuração de Cache e Filas
REDIS_PORT=6379
REDIS_HOST=localhost

RABBITMQ_USER=root
RABBITMQ_PASSWORD=password
RABBITMQ_PORT=5672
RABBITMQ_HOST=localhost

# Configurações da API
API_PORT=8080
LOG_LEVEL=debug

# Autenticação e Webhooks (ADR-014 e ADR-016)
PSP_WEBHOOK_SECRET=replace_this_with_real_secret

# Observabilidade (ADR-013)
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

# Grafana Security (ADR-018: Obrigatório definir credenciais fortes; sem fallback padrão)
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=replace_with_secure_admin_password
GF_AUTH_ANONYMOUS_ENABLED=false

# Segurança Zero Trust (ADR-008 e ADR-018: Chave simétrica HMAC-SHA256 de pelo menos 256 bits / 32 bytes)
JWT_SECRET=replace_with_secure_random_256bit_jwt_secret_key
PIN_HMAC_SECRET=replace_with_secure_random_256bit_pin_hmac_secret_key
# PREVIOUS_PIN_HMAC_SECRET=optional_previous_256bit_key_for_zero_downtime_rotation

# Seeds Seguros Zero Trust (ADR-018: Hashes gerados com bcrypt cost 12)
SEED_MERCHANT_EMAIL=loja@elo.com
SEED_MERCHANT_PASSWORD=replace_with_merchant_password
SEED_DELIVERER_EMAIL=entregador@elo.com
SEED_DELIVERER_PASSWORD=replace_with_deliverer_password
SEED_ADMIN_EMAIL=admin@elo.com
SEED_ADMIN_PASSWORD=replace_with_admin_password

# Credenciais de Autenticação do Simulador
DELIVERER_EMAIL=entregador@elo.com
DELIVERER_PASSWORD=replace_with_deliverer_password
DELIVERER_FINGERPRINT=simulator-deliverer-worker-1


