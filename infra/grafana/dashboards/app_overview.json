      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "editorMode": "code",
          "expr": "((sum(rate(app_http_duration_seconds_count{status_code=~\"5..\"}[5m])) or vector(0)) / (sum(rate(app_http_duration_seconds_count[5m])) > 0)) * 100",
          "legendFormat": "5xx Error %",
          "range": true,
          "refId": "A"
